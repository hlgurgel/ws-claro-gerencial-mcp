# Claro Gerencial MCP — Variáveis de Ambiente
#
# Copie este arquivo para .env e preencha com suas credenciais:
#   cp .env.example .env

# Credenciais de acesso ao Claro Gerencial
CLARO_USUARIO=seu_usuario
CLARO_SENHA=sua_senha

# Ambiente: "homologacao" ou "producao"
CLARO_AMBIENTE=homologacao

# URLs base dos WebServices (opcional — padrão aponta para produção)
# CLARO_URL_BASE_OUTPUT=https://clarogerencial.redeinova.com.br/wsoutput
# CLARO_URL_BASE_INPUT=https://clarogerencial.redeinova.com.br/wsinput
